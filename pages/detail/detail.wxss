.detail-page {
  padding-bottom: 92rpx;
}

.hero-image,
.hero-placeholder {
  width: 100%;
  height: 430rpx;
  border: 4rpx solid #fffdf7;
  border-radius: 34rpx;
  box-shadow: 0 8rpx 0 0 #d4c9b4, 0 16rpx 26rpx rgba(121, 79, 39, 0.1);
}

.hero-image {
  background: #e6f9f6;
}

.hero-placeholder {
  background: #e6f9f6;
  color: #19a99d;
  font-size: 76rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.headline {
  margin-top: 36rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.title-block {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.category {
  align-self: flex-start;
  max-width: 170rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e6f9f6;
  color: #147f76;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category.category-meat {
  background: #fff2ef;
  color: #ad4638;
}

.category.category-staple,
.category.category-dessert,
.category.category-breakfast,
.category.category-quick {
  background: #fff5df;
  color: #9f6817;
}

.category.category-soup {
  background: #edf6fc;
  color: #3a7598;
}

.title {
  margin-top: 14rpx;
  color: #4f351f;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.updated {
  margin-top: 10rpx;
  color: #9f927d;
  font-size: 25rpx;
  font-weight: 700;
}

.edit-button {
  width: 132rpx;
  flex: none;
  margin-top: 48rpx;
}

.section {
  margin-top: 26rpx;
  padding: 28rpx;
  border: 3rpx solid #d8c7a7;
  border-radius: 32rpx;
  background: rgb(247, 243, 223);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: 0 7rpx 0 0 #d4c9b4, 0 12rpx 22rpx rgba(121, 79, 39, 0.08);
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-icon {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid #11a89b;
  border-radius: 50%;
  background: #19c8b9;
  color: #fffdf7;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
}

.section-title {
  color: #794f27;
  font-size: 31rpx;
  font-weight: 900;
}

.section-content {
  color: #725d42;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}

.section-content.is-empty {
  color: #9f927d;
}

.delete-button {
  width: 100%;
  height: 88rpx;
  margin-top: 58rpx;
  border: 3rpx solid #e05a5a;
  border-radius: 999rpx;
  color: #c94444;
  background: #fff9f7;
  font-size: 29rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 7rpx 0 0 #efb8af;
  transition: all 0.18s;
}

.delete-button:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 0 #efb8af;
}
