<view class="home-screen">
  <image class="home-bg" src="/assets/ui/page-bg.jpg" mode="scaleToFill" />

  <view class="brand-sign">
    <image class="brand-sign-img" src="/assets/ui/hanging-sign.png" mode="scaleToFill" />
    <text class="brand-text">私人菜谱本</text>
  </view>

  <text class="hero-title">今天吃什么</text>
  <text class="count-pill">12 道菜</text>
  <view class="add-fab" hover-class="tap-down" bindtap="goCreate">+</view>

  <view class="search-shell">
    <image class="search-shell-img" src="/assets/ui/search-shell.png" mode="scaleToFill" />
    <image class="search-icon" src="/assets/ui/icon-search.png" mode="aspectFit" />
    <text class="search-placeholder">搜索菜名、食材或备注</text>
    <input class="search-hit" value="{{query}}" bindinput="onSearchInput" />
  </view>

  <view class="category-strip">
    <view class="cat-chip cat-active" hover-class="tap-down" data-key="all" bindtap="onCategoryTap">全部</view>
    <view class="cat-chip" hover-class="tap-down" data-key="meat" bindtap="onCategoryTap">荤菜</view>
    <view class="cat-chip" hover-class="tap-down" data-key="vegetable" bindtap="onCategoryTap">素菜</view>
    <view class="cat-chip cat-soup" hover-class="tap-down" data-key="soup" bindtap="onCategoryTap">汤</view>
    <view class="cat-chip cat-quick" hover-class="tap-down" data-key="quick" bindtap="onCategoryTap">快手菜</view>
    <view class="cat-chip cat-more" hover-class="tap-down" bindtap="toggleCategories">更多分类⌄</view>
  </view>

  <view class="category-panel">
    <image class="category-panel-img" src="/assets/ui/category-panel.png" mode="scaleToFill" />
    <view class="category-grid">
      <view class="category-tile" hover-class="tap-down" data-key="staple" bindtap="onCategoryTap">
        <image class="category-tile-bg" src="/assets/ui/category-button.png" mode="scaleToFill" />
        <image class="category-icon" src="/assets/ui/icon-staple.png" mode="aspectFit" />
        <text>主食</text>
      </view>
      <view class="category-tile" hover-class="tap-down" data-key="dessert" bindtap="onCategoryTap">
        <image class="category-tile-bg" src="/assets/ui/category-button.png" mode="scaleToFill" />
        <image class="category-icon" src="/assets/ui/icon-dessert.png" mode="aspectFit" />
        <text>甜点</text>
      </view>
      <view class="category-tile" hover-class="tap-down" data-key="breakfast" bindtap="onCategoryTap">
        <image class="category-tile-bg" src="/assets/ui/category-button.png" mode="scaleToFill" />
        <image class="category-icon" src="/assets/ui/icon-breakfast.png" mode="aspectFit" />
        <text>早餐</text>
      </view>
      <view class="category-tile" hover-class="tap-down" data-key="home" bindtap="onCategoryTap">
        <image class="category-tile-bg" src="/assets/ui/category-button.png" mode="scaleToFill" />
        <image class="category-icon" src="/assets/ui/icon-home.png" mode="aspectFit" />
        <text>家常菜</text>
      </view>
      <view class="category-tile" hover-class="tap-down" data-key="rice" bindtap="onCategoryTap">
        <image class="category-tile-bg" src="/assets/ui/category-button.png" mode="scaleToFill" />
        <image class="category-icon" src="/assets/ui/icon-rice.png" mode="aspectFit" />
        <text>下饭菜</text>
      </view>
      <view class="category-tile" hover-class="tap-down" data-key="favorite" bindtap="onCategoryTap">
        <image class="category-tile-bg" src="/assets/ui/category-button.png" mode="scaleToFill" />
        <image class="category-icon" src="/assets/ui/icon-favorite.png" mode="aspectFit" />
        <text>收藏</text>
      </view>
    </view>
  </view>

  <view class="decision-card">
    <image class="decision-card-img" src="/assets/ui/decision-board.png" mode="scaleToFill" />
    <text class="decision-title">不知道吃什么？</text>
    <text class="decision-subtitle">从你的菜谱里抽一道，或配一套今天的饭</text>
    <view class="decision-btn decision-random" hover-class="tap-down" bindtap="pickRandomRecipe">
      <image class="decision-btn-img" src="/assets/ui/button-teal.png" mode="scaleToFill" />
      <view class="decision-content decision-content-random">
        <image class="decision-icon" src="/assets/ui/icon-shuffle.png" mode="aspectFit" />
        <text>随机一道</text>
      </view>
    </view>
    <view class="decision-btn decision-meal" hover-class="tap-down" bindtap="generateMealSet">
      <image class="decision-btn-img" src="/assets/ui/button-yellow.png" mode="scaleToFill" />
      <view class="decision-content decision-content-meal">
        <image class="decision-icon cloche" src="/assets/ui/icon-cloche.png" mode="aspectFit" />
        <text>生成菜谱</text>
      </view>
    </view>
  </view>

  <view class="list-head">
    <text class="list-title">我的菜谱</text>
    <text class="list-count">全部 · 12 道</text>
  </view>

  <view class="recipe-card card-1" hover-class="tap-down" data-id="demo_beef_potato" bindtap="goDetail">
    <image class="recipe-card-bg" src="/assets/ui/recipe-card.png" mode="scaleToFill" />
    <image class="recipe-photo" src="/assets/demo-recipes/beef-potato.png" mode="aspectFill" />
    <image class="recipe-frame" src="/assets/ui/image-frame.png" mode="scaleToFill" />
    <text class="recipe-tag">荤菜</text>
    <text class="recipe-name">番茄牛腩炖土豆</text>
  </view>

  <view class="recipe-card card-2" hover-class="tap-down" data-id="demo_shrimp" bindtap="goDetail">
    <image class="recipe-card-bg" src="/assets/ui/recipe-card.png" mode="scaleToFill" />
    <image class="recipe-photo" src="/assets/demo-recipes/shrimp-vermicelli.png" mode="aspectFill" />
    <image class="recipe-frame" src="/assets/ui/image-frame.png" mode="scaleToFill" />
    <text class="recipe-tag">海鲜</text>
    <text class="recipe-name">蒜蓉粉丝蒸虾</text>
  </view>

  <view class="recipe-card card-3" hover-class="tap-down" data-id="demo_greens" bindtap="goDetail">
    <image class="recipe-card-bg" src="/assets/ui/recipe-card.png" mode="scaleToFill" />
    <image class="recipe-photo" src="/assets/demo-recipes/greens.png" mode="aspectFill" />
    <image class="recipe-frame" src="/assets/ui/image-frame.png" mode="scaleToFill" />
    <text class="recipe-tag">素菜</text>
    <text class="recipe-name">清炒时令小青菜</text>
  </view>

  <view class="recipe-card card-4" hover-class="tap-down" data-id="demo_soup" bindtap="goDetail">
    <image class="recipe-card-bg" src="/assets/ui/recipe-card.png" mode="scaleToFill" />
    <image class="recipe-photo" src="/assets/demo-recipes/seaweed-soup.png" mode="aspectFill" />
    <image class="recipe-frame" src="/assets/ui/image-frame.png" mode="scaleToFill" />
    <text class="recipe-tag">汤</text>
    <text class="recipe-name">紫菜蛋花汤</text>
  </view>

  <view wx:if="{{randomVisible}}" class="modal-mask">
    <view class="modal-panel" catchtap="noop">
      <image class="modal-bg" src="/assets/ui/popup-panel.png" mode="scaleToFill" />
      <text class="modal-kicker">{{randomScopeText}}抽到</text>
      <image wx:if="{{randomRecipe.imagePath}}" class="modal-photo" src="{{randomRecipe.imagePath}}" mode="aspectFill" />
      <text class="modal-title">{{randomRecipe.title}}</text>
      <view class="modal-actions">
        <view class="modal-action" hover-class="tap-down" bindtap="pickRandomRecipe">换一道</view>
        <view class="modal-action primary" hover-class="tap-down" bindtap="closeRandomPanel">先这样</view>
      </view>
      <view class="modal-close" hover-class="tap-down" bindtap="closeRandomPanel">关闭</view>
    </view>
  </view>
</view>
