.index-page {
  padding-bottom: 92rpx;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 104rpx;
  margin-bottom: 22rpx;
}

.title-stack {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.page-kicker {
  color: #7b6b4f;
  font-size: 23rpx;
  font-weight: 800;
}

.page-title {
  color: #182019;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.16;
}

.header-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex: none;
}

.count {
  color: #2f7d4a;
  font-size: 24rpx;
  font-weight: 700;
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  line-height: 46rpx;
}

.add-button {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #2f7d4a;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(47, 125, 74, 0.18);
}

.search-box {
  height: 82rpx;
  padding: 0 26rpx;
  border: 2rpx solid #eef0ea;
  border-radius: 12rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(27, 36, 29, 0.04);
}

.search-icon {
  color: #7a837a;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  height: 78rpx;
  color: #182019;
  font-size: 28rpx;
}

.placeholder {
  color: #9aa49b;
}

.decision-bar {
  margin-bottom: 22rpx;
  min-height: 128rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff6e8;
  border: 2rpx solid #f0ddb9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 16rpx 36rpx rgba(127, 86, 24, 0.1);
}

.decision-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.decision-title {
  color: #2b2116;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.24;
}

.decision-meta {
  color: #7e725e;
  font-size: 23rpx;
  line-height: 1.4;
}

.decision-actions {
  width: 184rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  flex: none;
}

.decision-button {
  width: 100%;
  height: 52rpx;
  border-radius: 10rpx;
  background: #c66a1d;
  color: #fffaf2;
  font-size: 23rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(198, 106, 29, 0.2);
}

.decision-button.secondary-random {
  border: 2rpx solid #e6cda6;
  background: #fffdf8;
  color: #9f6817;
  box-shadow: none;
}

.category-strip {
  width: 100%;
  margin: 22rpx 0 18rpx;
  white-space: nowrap;
}

.recipe-section {
  margin-top: 2rpx;
}

.list-heading {
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.list-title {
  color: #182019;
  font-size: 30rpx;
  font-weight: 900;
}

.list-count {
  color: #7b8479;
  font-size: 24rpx;
}

.category-list {
  display: flex;
  gap: 12rpx;
  padding-right: 2rpx;
}

.category-pill {
  min-width: 96rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e6ebe4;
  border-radius: 999rpx;
  background: #ffffff;
  color: #3f4842;
  font-size: 25rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.category-pill.is-active {
  border-color: #2f7d4a;
  background: #2f7d4a;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(47, 125, 74, 0.15);
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recipe-item {
  width: 100%;
  min-height: 172rpx;
  padding: 16rpx;
  border: 2rpx solid #edf0eb;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  gap: 20rpx;
  text-align: left;
  box-shadow: 0 8rpx 20rpx rgba(27, 36, 29, 0.04);
}

.recipe-image,
.recipe-placeholder {
  width: 180rpx;
  height: 150rpx;
  border-radius: 14rpx;
  flex: none;
}

.recipe-placeholder {
  background: #e8f1ea;
  color: #2f7d4a;
  font-size: 44rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recipe-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.recipe-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.recipe-title {
  min-width: 0;
  flex: 1;
  color: #182019;
  font-size: 32rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-category {
  max-width: 132rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  color: #2f7d4a;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: none;
}

.recipe-category.category-meat {
  background: #fff2ef;
  color: #ad4638;
}

.recipe-category.category-staple,
.recipe-category.category-dessert {
  background: #fff5df;
  color: #9f6817;
}

.recipe-category.category-soup {
  background: #edf6fc;
  color: #3a7598;
}

.recipe-meta {
  margin-top: 8rpx;
  color: #7d877e;
  font-size: 22rpx;
}

.recipe-note {
  margin-top: 6rpx;
  color: #566158;
  font-size: 25rpx;
  line-height: 1.45;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.empty-state {
  min-height: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.empty-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #edf4ef;
  color: #2f7d4a;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  color: #182019;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: #6e786f;
  font-size: 27rpx;
}

.empty-action {
  margin-top: 34rpx;
  width: 320rpx;
}

.empty-actions {
  width: 100%;
  max-width: 460rpx;
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.empty-small-action {
  width: 100%;
}

.random-overlay {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 44rpx 28rpx 0;
  background: rgba(15, 23, 18, 0.48);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.random-panel {
  width: 100%;
  max-width: none;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 18, 0.24);
}

.meal-panel {
  width: 100%;
  max-width: none;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 18, 0.24);
}

.meal-title {
  color: #182019;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.meal-subtitle {
  max-width: 100%;
  margin-top: 10rpx;
  color: #7e725e;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: center;
}

.meal-list {
  width: 100%;
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.meal-item {
  width: 100%;
  min-height: 118rpx;
  padding: 12rpx;
  border: 2rpx solid #edf0eb;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  text-align: left;
}

.meal-image,
.meal-placeholder {
  width: 108rpx;
  height: 94rpx;
  border-radius: 12rpx;
  flex: none;
}

.meal-placeholder {
  background: #edf4ef;
  color: #2f7d4a;
  font-size: 38rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meal-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meal-slot {
  color: #7b6b4f;
  font-size: 22rpx;
  font-weight: 900;
}

.meal-slot-status {
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #fff5df;
  color: #9f6817;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.meal-recipe-title {
  color: #182019;
  font-size: 30rpx;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-category {
  align-self: flex-start;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  color: #2f7d4a;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.meal-category.category-meat {
  background: #fff2ef;
  color: #ad4638;
}

.meal-category.category-staple,
.meal-category.category-dessert {
  background: #fff5df;
  color: #9f6817;
}

.meal-category.category-soup {
  background: #edf6fc;
  color: #3a7598;
}

.meal-arrow {
  color: #9aa49b;
  font-size: 42rpx;
  flex: none;
}

.random-panel-kicker {
  color: #996612;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.random-panel-image,
.random-panel-placeholder {
  width: 100%;
  height: 336rpx;
  border-radius: 18rpx;
}

.random-panel-placeholder {
  background: #edf4ef;
  color: #2f7d4a;
  font-size: 72rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.random-panel-title {
  max-width: 100%;
  margin-top: 24rpx;
  color: #182019;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  word-break: break-all;
}

.random-panel-category {
  margin-top: 12rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #edf4ef;
  color: #2f7d4a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.random-panel-note {
  width: 100%;
  margin-top: 18rpx;
  color: #465049;
  font-size: 27rpx;
  line-height: 1.55;
  text-align: center;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.random-panel-actions {
  width: 100%;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.random-panel-action {
  width: 100%;
}

.random-close {
  margin-top: 20rpx;
  color: #6e786f;
  font-size: 26rpx;
}
