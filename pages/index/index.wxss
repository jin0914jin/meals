.home-screen {
  position: relative;
  width: 750rpx;
  min-height: 1840rpx;
  overflow-x: hidden;
  background: #fbf4e6;
  color: #5b3418;
}

.tap-down {
  transform: translateY(3rpx);
}

.home-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 1840rpx;
  z-index: 0;
}

.brand-sign {
  position: absolute;
  left: 38rpx;
  top: 0;
  width: 302rpx;
  height: 106rpx;
  z-index: 2;
}

.brand-sign-img {
  width: 100%;
  height: 100%;
}

.brand-text {
  position: absolute;
  left: 0;
  top: 44rpx;
  width: 302rpx;
  color: #5b3418;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  text-shadow: 0 2rpx 0 rgba(255, 224, 176, 0.65);
  z-index: 3;
}

.hero-title {
  position: absolute;
  left: 42rpx;
  top: 126rpx;
  width: 420rpx;
  color: #5b3418;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 2rpx 0 rgba(255, 224, 176, 0.48);
  z-index: 2;
}

.count-pill {
  position: absolute;
  left: 502rpx;
  top: 122rpx;
  width: 130rpx;
  height: 62rpx;
  border: 3rpx solid #e2cda7;
  border-radius: 999rpx;
  background: rgba(255, 248, 226, 0.88);
  color: #6b411f;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  z-index: 2;
}

.add-fab {
  position: absolute;
  left: 648rpx;
  top: 104rpx;
  width: 84rpx;
  height: 84rpx;
  border: 4rpx solid #b96516;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 26%, #ffd973 0%, #ffbd27 58%, #d78015 100%);
  color: #6b3b0e;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 8rpx 0 0 #9a5314, 0 14rpx 18rpx rgba(117, 66, 15, 0.22);
  z-index: 2;
}

.search-shell {
  position: absolute;
  left: 42rpx;
  top: 218rpx;
  width: 666rpx;
  height: 110rpx;
  z-index: 2;
}

.search-shell-img {
  position: absolute;
  width: 100%;
  height: 100%;
}

.search-icon {
  position: absolute;
  left: 32rpx;
  top: 30rpx;
  width: 48rpx;
  height: 48rpx;
  opacity: 0.82;
  z-index: 2;
}

.search-placeholder {
  position: absolute;
  left: 100rpx;
  top: 35rpx;
  color: #a89980;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 40rpx;
  z-index: 2;
}

.search-hit {
  position: absolute;
  left: 100rpx;
  top: 15rpx;
  width: 520rpx;
  height: 80rpx;
  opacity: 0.01;
  z-index: 3;
}

.category-strip {
  position: absolute;
  left: 42rpx;
  top: 360rpx;
  width: 666rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 2;
}

.cat-chip {
  flex: 0 0 82rpx;
  width: 82rpx;
  height: 58rpx;
  padding: 0;
  border: 2rpx solid #ead8b4;
  border-radius: 999rpx;
  background: rgba(248, 241, 223, 0.92);
  color: #725d42;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 54rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: 0 4rpx 0 0 #e4d0aa;
}

.cat-active {
  border-color: #129f93;
  background: #19bbae;
  color: #fffdf7;
  box-shadow: 0 5rpx 0 0 #0d8d83;
}

.cat-soup {
  flex-basis: 72rpx;
  width: 72rpx;
}

.cat-quick {
  flex-basis: 112rpx;
  width: 112rpx;
}

.cat-more {
  flex-basis: 150rpx;
  width: 150rpx;
  border-color: #19a99d;
  color: #178c82;
  background: rgba(255, 253, 247, 0.92);
}

.category-panel {
  position: absolute;
  left: 42rpx;
  top: 447rpx;
  width: 666rpx;
  height: 235rpx;
  z-index: 2;
}

.category-panel-img {
  position: absolute;
  width: 100%;
  height: 100%;
}

.category-grid {
  position: absolute;
  left: 30rpx;
  top: 34rpx;
  width: 606rpx;
  height: 184rpx;
  display: flex;
  flex-wrap: wrap;
  align-content: space-between;
  justify-content: space-between;
  z-index: 2;
}

.category-tile {
  position: relative;
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 82rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: #725d42;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.category-tile-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 188rpx;
  height: 82rpx;
  z-index: 0;
}

.category-icon,
.category-tile text {
  position: relative;
  z-index: 1;
}

.category-icon {
  width: 42rpx;
  height: 42rpx;
}

.decision-card {
  position: absolute;
  left: 42rpx;
  top: 713rpx;
  width: 666rpx;
  height: 247rpx;
  z-index: 2;
}

.decision-card-img {
  position: absolute;
  width: 100%;
  height: 100%;
}

.decision-title {
  position: absolute;
  left: 50rpx;
  top: 39rpx;
  color: #5b3418;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  z-index: 2;
}

.decision-subtitle {
  position: absolute;
  left: 50rpx;
  top: 91rpx;
  color: #6f4b2d;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  z-index: 2;
}

.decision-btn {
  position: absolute;
  top: 132rpx;
  width: 286rpx;
  height: 94rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 999rpx;
  color: #725d42;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
  z-index: 2;
}

.decision-random {
  left: 36rpx;
  color: #fffdf7;
}

.decision-meal {
  left: 344rpx;
}

.decision-btn-img {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.decision-content {
  position: absolute;
  left: 0;
  top: 11rpx;
  width: 100%;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  white-space: nowrap;
  z-index: 1;
}

.decision-content-random {
  left: 2rpx;
}

.decision-content-meal {
  left: -1rpx;
  top: 10rpx;
}

.decision-content text {
  display: block;
  height: 40rpx;
  line-height: 40rpx;
}

.decision-icon {
  display: block;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
}

.decision-icon.cloche {
  flex-basis: 44rpx;
  width: 44rpx;
  height: 44rpx;
  transform: translateY(1rpx);
}

.list-head {
  position: absolute;
  left: 42rpx;
  top: 995rpx;
  width: 666rpx;
  height: 52rpx;
  z-index: 2;
}

.list-title {
  position: absolute;
  left: 0;
  top: 0;
  color: #5b3418;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.list-count {
  position: absolute;
  right: 0;
  top: 4rpx;
  color: #178c82;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}

.recipe-card {
  position: absolute;
  left: 42rpx;
  width: 666rpx;
  height: 178rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 22rpx;
  z-index: 2;
}

.card-1 {
  top: 1048rpx;
}

.card-2 {
  top: 1242rpx;
}

.card-3 {
  top: 1436rpx;
}

.card-4 {
  top: 1630rpx;
}

.recipe-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 666rpx;
  height: 178rpx;
}

.recipe-photo {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 356rpx;
  height: 162rpx;
  border-radius: 18rpx;
  z-index: 1;
}

.recipe-frame {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 356rpx;
  height: 162rpx;
  z-index: 2;
}

.recipe-tag {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  min-width: 76rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border: 2rpx solid #ead8b4;
  border-radius: 999rpx;
  background: rgba(255, 247, 222, 0.96);
  color: #8f5d19;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  z-index: 3;
}

.recipe-name {
  position: absolute;
  left: 402rpx;
  top: 68rpx;
  width: 238rpx;
  color: #5b3418;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: left;
  z-index: 2;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(79, 53, 31, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-panel {
  position: relative;
  width: 720rpx;
  height: 650rpx;
  padding-top: 60rpx;
}

.modal-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 720rpx;
  height: 650rpx;
}

.modal-kicker,
.modal-photo,
.modal-title,
.modal-actions,
.modal-close {
  position: relative;
  z-index: 1;
}

.modal-kicker {
  display: block;
  color: #9f6817;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.modal-photo {
  display: block;
  width: 600rpx;
  height: 260rpx;
  margin: 24rpx auto 0;
  border-radius: 30rpx;
}

.modal-title {
  display: block;
  margin-top: 24rpx;
  color: #4f351f;
  font-size: 42rpx;
  font-weight: 900;
  text-align: center;
}

.modal-actions {
  width: 600rpx;
  margin: 28rpx auto 0;
  display: flex;
  gap: 18rpx;
}

.modal-action {
  flex: 1;
  height: 78rpx;
  border: 3rpx solid #c4b89e;
  border-radius: 999rpx;
  background: #fffdf7;
  color: #725d42;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

.modal-action.primary {
  border-color: #dba90e;
  background: #ffcc00;
}

.modal-close {
  display: block;
  margin: 18rpx auto 0;
  color: #8a7b66;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}
