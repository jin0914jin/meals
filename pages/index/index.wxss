.index-page {
  padding: 36rpx 38rpx 96rpx;
}

.page-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.brand-sign {
  position: relative;
  width: 306rpx;
  height: 96rpx;
  padding: 10rpx 38rpx 0;
  border: 0;
  border-radius: 0;
  background: url("/assets/ui/wood-sign.png") center / 100% 100% no-repeat;
  color: #5b3418;
  font-size: 35rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-shadow: 0 2rpx 0 rgba(255, 221, 164, 0.45);
}

.sign-rope {
  position: absolute;
  top: -34rpx;
  width: 10rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8c6537, #d5a36d, #8c6537);
}

.sign-rope.left {
  left: 48rpx;
}

.sign-rope.right {
  right: 48rpx;
}

.title-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.page-title {
  min-width: 0;
  flex: 1;
  color: #5a3419;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.header-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  flex: none;
}

.count {
  height: 64rpx;
  min-width: 136rpx;
  padding: 0 22rpx;
  border: 3rpx solid #e3d2b2;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.78);
  color: #6b411f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.add-button {
  width: 82rpx;
  height: 82rpx;
  border: 4rpx solid #b96516;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #ffd973 0%, #ffbd27 58%, #d78015 100%);
  color: #6b3b0e;
  font-size: 58rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 0 0 #9a5314, 0 13rpx 20rpx rgba(117, 66, 15, 0.2);
}

.add-button:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 0 #bdaea0;
}

.search-box {
  height: 96rpx;
  padding: 0 34rpx;
  border: 4rpx solid rgba(25, 151, 141, 0.45);
  border-radius: 999rpx;
  background: #fffdf7;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 6rpx 0 0 rgba(25, 151, 141, 0.16), inset 0 0 0 3rpx rgba(255, 255, 255, 0.8);
}

.search-icon {
  width: 42rpx;
  height: 42rpx;
  flex: none;
}

.search-input {
  flex: 1;
  height: 86rpx;
  color: #725d42;
  font-size: 31rpx;
  font-weight: 500;
}

.placeholder {
  color: #c4b89e;
}

.category-board {
  margin: 28rpx 0 30rpx;
}

.category-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 14rpx;
  overflow: hidden;
}

.category-pill {
  min-width: 90rpx;
  height: 62rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e8d9bd;
  border-radius: 999rpx;
  background: #f8f1df;
  color: #725d42;
  font-size: 27rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: 0 4rpx 0 0 #e1cfad;
}

.category-pill.is-active {
  border-color: #129f93;
  background: #19bbae;
  color: #fffdf7;
  box-shadow: 0 5rpx 0 0 #0d8d83;
}

.category-pill:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 0 0 #d4c9b4;
}

.category-more {
  min-width: 164rpx;
  border-color: #19a99d;
  color: #178c82;
  background: #f8f8f0;
}

.category-more-icon {
  margin-left: 6rpx;
  font-size: 22rpx;
}

.category-collection {
  position: relative;
  margin-top: 26rpx;
  padding: 28rpx;
  border: 2rpx solid #e5dac8;
  border-radius: 24rpx;
  background: #f8eac6;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  box-shadow: 0 8rpx 0 0 #d1ad6b, 0 18rpx 26rpx rgba(114, 93, 66, 0.12);
}

.category-collection::before {
  content: "";
  position: absolute;
  right: 80rpx;
  top: -22rpx;
  width: 38rpx;
  height: 38rpx;
  background: #f8eac6;
  border-left: 2rpx solid #e5dac8;
  border-top: 2rpx solid #e5dac8;
  transform: rotate(45deg);
}

.category-collection-pill {
  position: relative;
  min-width: 0;
  width: 100%;
  height: 92rpx;
  padding: 0 12rpx;
  border-color: #ead8b4;
  background: #fffdf7;
  font-size: 29rpx;
  gap: 12rpx;
  box-shadow: 0 4rpx 0 0 #e4cda4;
}

.category-icon {
  width: 48rpx;
  height: 48rpx;
  flex: none;
}

.decision-bar {
  position: relative;
  margin-bottom: 36rpx;
  padding: 34rpx 34rpx 30rpx;
  border: 4rpx solid #19a99d;
  border-radius: 24rpx;
  background: #e5f6f2;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  overflow: hidden;
  box-shadow: 0 7rpx 0 0 #11877e, 0 18rpx 30rpx rgba(25, 151, 141, 0.12);
}

.decision-scene {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  width: 270rpx;
  height: 96rpx;
  background: url("/assets/ui/decision-scene.png") center / contain no-repeat;
  opacity: 0.85;
  pointer-events: none;
}

.decision-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}

.decision-title {
  color: #5a3419;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.24;
}

.decision-meta {
  color: #725d42;
  font-size: 27rpx;
  line-height: 1.45;
}

.decision-actions {
  position: relative;
  z-index: 1;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.decision-button {
  width: 100%;
  height: 86rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ffcc00;
  color: #725d42;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 0 0 #b56a17, 0 12rpx 18rpx rgba(181, 106, 23, 0.15);
}

.decision-button-icon {
  width: 42rpx;
  height: 42rpx;
  flex: none;
}

.decision-button-icon.cloche {
  width: 46rpx;
  height: 46rpx;
}

.decision-button.secondary-random {
  border: 3rpx solid #129f93;
  background: #24c4b8;
  color: #fffdf7;
  box-shadow: 0 8rpx 0 0 #0d8d83, 0 12rpx 18rpx rgba(13, 141, 131, 0.15);
}

.decision-button:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 0 #bdaea0;
}

.recipe-section {
  margin-top: 2rpx;
}

.list-heading {
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.list-title {
  color: #5a3419;
  font-size: 34rpx;
  font-weight: 900;
}

.list-count {
  color: #178c82;
  font-size: 27rpx;
  font-weight: 900;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.recipe-item {
  width: 100%;
  min-height: 160rpx;
  padding: 8rpx;
  border: 3rpx solid #ead8b4;
  border-radius: 22rpx;
  background: #fffdf7;
  display: flex;
  align-items: center;
  gap: 28rpx;
  text-align: left;
  box-shadow: 0 5rpx 0 0 #e4cda4, 0 10rpx 18rpx rgba(114, 93, 66, 0.08);
}

.recipe-item:active {
  transform: translateY(2rpx);
}

.recipe-cover {
  position: relative;
  width: 340rpx;
  height: 146rpx;
  border-radius: 18rpx;
  overflow: hidden;
  flex: none;
  background: #f0e8d8;
}

.recipe-image,
.recipe-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.recipe-placeholder {
  background: #e6f9f6;
  color: #19a99d;
  font-size: 44rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recipe-category {
  position: absolute;
  left: 14rpx;
  top: 12rpx;
  max-width: 130rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.9);
  color: #147f76;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(79, 53, 31, 0.14);
}

.recipe-category.category-meat,
.random-panel-category.category-meat,
.meal-category.category-meat {
  color: #ad4638;
}

.recipe-category.category-staple,
.recipe-category.category-dessert,
.recipe-category.category-breakfast,
.recipe-category.category-quick,
.random-panel-category.category-staple,
.random-panel-category.category-dessert,
.random-panel-category.category-breakfast,
.random-panel-category.category-quick,
.meal-category.category-staple,
.meal-category.category-dessert,
.meal-category.category-breakfast,
.meal-category.category-quick {
  color: #9f6817;
}

.recipe-category.category-soup,
.random-panel-category.category-soup,
.meal-category.category-soup {
  color: #3a7598;
}

.recipe-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
}

.recipe-title {
  width: 100%;
  color: #4f351f;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.28;
  word-break: break-all;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.empty-state {
  min-height: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.empty-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #e6f9f6;
  color: #19a99d;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  color: #4f351f;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-text {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: #8a7b66;
  font-size: 27rpx;
}

.empty-action {
  margin-top: 34rpx;
  width: 320rpx;
}

.empty-actions {
  width: 100%;
  max-width: 460rpx;
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.empty-small-action {
  width: 100%;
}

.random-overlay {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 44rpx 22rpx 0;
  background: rgba(79, 53, 31, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.random-panel,
.meal-panel {
  width: 100%;
  max-width: none;
  padding: 30rpx 26rpx calc(30rpx + env(safe-area-inset-bottom));
  border: 4rpx solid #e5dac8;
  border-radius: 30rpx 30rpx 0 0;
  background: #f8f1df;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(79, 53, 31, 0.24);
}

.random-panel-kicker {
  color: #9f6817;
  font-size: 24rpx;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.random-panel-cover {
  position: relative;
  width: 100%;
  height: 336rpx;
  border: 3rpx solid #ead8b4;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fffdf7;
}

.random-panel-image,
.random-panel-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.random-panel-placeholder {
  background: #e6f9f6;
  color: #19a99d;
  font-size: 72rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.random-panel-category {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ead8b4;
  background: rgba(255, 247, 222, 0.94);
  color: #147f76;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.random-panel-title {
  max-width: 100%;
  margin-top: 24rpx;
  color: #4f351f;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.22;
  text-align: center;
  word-break: break-all;
}

.random-panel-note {
  width: 100%;
  margin-top: 18rpx;
  color: #725d42;
  font-size: 27rpx;
  line-height: 1.55;
  text-align: center;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.random-panel-actions {
  width: 100%;
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.random-panel-action {
  width: 100%;
}

.random-close {
  margin-top: 20rpx;
  color: #8a7b66;
  font-size: 26rpx;
}

.meal-title {
  color: #4f351f;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.meal-subtitle {
  max-width: 100%;
  margin-top: 10rpx;
  color: #9f927d;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: center;
}

.meal-list {
  width: 100%;
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.meal-item {
  width: 100%;
  min-height: 118rpx;
  padding: 12rpx;
  border: 2rpx solid #eadfce;
  border-radius: 20rpx;
  background: #fffdf7;
  display: flex;
  align-items: center;
  gap: 16rpx;
  text-align: left;
  box-shadow: 0 4rpx 0 0 #e4cda4;
}

.meal-image,
.meal-placeholder {
  width: 108rpx;
  height: 94rpx;
  border-radius: 16rpx;
  flex: none;
}

.meal-placeholder {
  background: #e6f9f6;
  color: #19a99d;
  font-size: 38rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meal-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meal-slot {
  color: #725d42;
  font-size: 22rpx;
  font-weight: 900;
}

.meal-slot-status {
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #fff5df;
  color: #9f6817;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 30rpx;
}

.meal-recipe-title {
  color: #4f351f;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meal-category {
  align-self: flex-start;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #e6f9f6;
  color: #147f76;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.meal-arrow {
  color: #c4b89e;
  font-size: 42rpx;
  flex: none;
}
