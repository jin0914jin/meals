page {
  min-height: 100vh;
  background: #fbfaf5;
  color: #182019;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 26rpx 28rpx 56rpx;
}

.muted {
  color: #7b8479;
}

.primary-button {
  min-height: 88rpx;
  padding: 0 34rpx;
  border-radius: 10rpx;
  background: #2f7d4a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 26rpx rgba(47, 125, 74, 0.15);
}

.secondary-button {
  height: 84rpx;
  padding: 0 30rpx;
  border: 2rpx solid #d8e6dc;
  border-radius: 10rpx;
  color: #2f7d4a;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.primary-button[disabled],
.secondary-button[disabled],
button[disabled] {
  opacity: 0.72;
  box-shadow: none;
}
