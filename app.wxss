page {
  min-height: 100vh;
  background: #fbf4e6;
  color: #725d42;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 26rpx 28rpx 56rpx;
}

.muted {
  color: #9f927d;
}

.primary-button {
  min-height: 88rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #ffcc00;
  color: #725d42;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 7rpx 0 0 #bdaea0;
}

.secondary-button {
  height: 84rpx;
  padding: 0 30rpx;
  border: 2rpx solid #c4b89e;
  border-radius: 999rpx;
  color: #725d42;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf7;
  box-shadow: 0 6rpx 0 0 #d4c9b4;
}

.primary-button[disabled],
.secondary-button[disabled],
button[disabled] {
  opacity: 0.72;
  box-shadow: none;
}
