page {
  min-height: 100vh;
  background: #fbf4e6;
  color: #725d42;
  font-family: Nunito, "Noto Sans SC", "PingFang SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 30rpx 30rpx 64rpx;
}

.muted {
  color: #9f927d;
}

.primary-button {
  min-height: 90rpx;
  padding: 0 36rpx;
  border: 3rpx solid #ffcc00;
  border-radius: 999rpx;
  background: #ffcc00;
  color: #725d42;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 0 0 #dba90e;
  transition: all 0.18s;
}

.primary-button:active {
  transform: translateY(5rpx);
  box-shadow: 0 3rpx 0 0 #dba90e;
}

.secondary-button {
  height: 84rpx;
  padding: 0 30rpx;
  border: 3rpx solid #c4b89e;
  border-radius: 999rpx;
  color: #725d42;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(247, 243, 223);
  box-shadow: 0 6rpx 0 0 #d4c9b4;
  transition: all 0.18s;
}

.secondary-button:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 0 #d4c9b4;
}

.primary-button[disabled],
.secondary-button[disabled],
button[disabled] {
  opacity: 0.56;
  box-shadow: none;
}
